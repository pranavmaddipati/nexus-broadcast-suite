// MISSING LINE 2399
        } else {
          // Standard browser getDisplayMedia fallback!
          navigator.mediaDevices.getDisplayMedia({
            video: {
              cursor: currentCaptureCursor ? 'always' : 'never'
            } as any,
            audio: false
          }).then(stream => {
            video.srcObject = stream
            if (!src.settings?.paused) safePlay(video)
          }).catch(err => {
            console.error('getDisplayMedia failed:', err)
          })
        }
      }
    }

    // Play/Pause control state handling
    const isLive = isSourceLive(src.id)
    const isPlayableType = ['media', 'video', 'ndi'].includes(src.type)
    
    let shouldPlay = true
    if (src.settings?.paused === true) {
      shouldPlay = false
    } else if (src.settings?.paused === false) {
      shouldPlay = true
    } else {
      // Default auto-cue: play live files, keep preview/non-live files cued (paused)
      shouldPlay = !isPlayableType || isLive
    }

    if (shouldPlay) {
      const activePaused = video.getAttribute('data-active-paused') === 'true'
      const currentPaused = src.settings?.paused === true
      if (activePaused !== currentPaused) {
        video.setAttribute('data-active-paused', currentPaused ? 'true' : 'false')
        video.removeAttribute('data-play-failed')
      }
      safePlay(video)
    } else {
      const activePaused = video.getAttribute('data-active-paused') === 'true'
      const currentPaused = src.settings?.paused === true
      if (activePaused !== currentPaused) {
        video.setAttribute('data-active-paused', currentPaused ? 'true' : 'false')
      }
      if (!video.paused) video.pause()
    }

    // Dynamically apply playback speed
    if (isPlayableType) {
      const targetSpeed = src.settings?.playbackSpeed || 1.0
      if (video.playbackRate !== targetSpeed) {
        video.playbackRate = targetSpeed
      }
    }

    return video
  }

  const getOrCreateImage = (srcId: string, path: string) => {
    let img = imageElementsRef.current[srcId]
    let created = false
    if (!img) {
      img = new Image()
      img.crossOrigin = 'anonymous'
      img.src = path
      imageElementsRef.current[srcId] = img
      created = true
    } else if (img.getAttribute('data-active-path') !== path) {
      img.src = path
      created = true
    }
    img.setAttribute('data-active-path', path)
    if (created) {
      setTimeout(() => setImageElements(prev => ({ ...prev, [srcId]: img })), 0)
    }
    return img
  }

  // Scanner helper for directory scanning
  const scanDirectoryRecursive = (dirPath: string): string[] => {
    const fs = window.require ? window.require('fs') : null
    const path = window.require ? window.require('path') : null
    if (!fs || !path) return []
    let files: string[] = []
    try {
      const entries = fs.readdirSync(dirPath)
      for (const entry of entries) {
        const fullPath = path.join(dirPath, entry)
        const stat = fs.statSync(fullPath)
        if (stat.isDirectory()) {
          files = files.concat(scanDirectoryRecursive(fullPath))
        } else {
          files.push(fullPath)
        }
      }
    } catch (e) {
      console.error("Error reading dir:", e)
    }
    return files
  }

  // Main Compositor loop
  useEffect(() => {
    RenderScheduler.start((time) => {
      const pCanvas = programCanvasRef.current
      const pCtx = pCanvas?.getContext('2d')
      const prCanvas = previewCanvasRef.current
      const prCtx = prCanvas?.getContext('2d')
      const vCanvas = vcamCanvasRef.current
      const vCtx = vCanvas?.getContext('2d')

      const activeSc = (scenes || []).find(s => s.id === activeScene)
      let liveSc = (scenes || []).find(s => s.id === liveScene)
      if (!liveSc && liveScene && typeof liveScene === 'string' && liveScene.endsWith('_live')) {
        liveSc = (scenes || []).find(s => s.id === liveScene.replace('_live', ''))
      }
      let fromSc = (scenes || []).find(s => s.id === transitionFromScene)
      if (!fromSc && transitionFromScene && typeof transitionFromScene === 'string' && transitionFromScene.endsWith('_live')) {
        fromSc = (scenes || []).find(s => s.id === transitionFromScene.replace('_live', ''))
      }

      const opts: CanvasRenderOptions = {
        time,
        canvasW: CANVAS_WIDTH,
        canvasH: CANVAS_HEIGHT,
        activeScene: activeSc,
        liveScene: liveSc,
        transitionFromScene: fromSc,
        isTransitioning,
        transitionProgress,
        transitionType,
        programFilters
      }

      CanvasRenderer.render(prCtx, pCtx, vCtx, opts, scenes, virtualCameraSettings, activeOverlays)
    })

    return () => {
      RenderScheduler.stop()
    }
  }, [scenes, activeScene, liveScene, isTransitioning, transitionProgress, transitionType, virtualCameraSettings, activeOverlays, programFilters])

  return (
    <BroadcastContext.Provider
      value={{
        desktopSources,
        loadDesktopSources,
        activeScene,
        liveScene,
        scenes,
      ctx.lineWidth = 3
      ctx.beginPath()
      ctx.arc(w / 2, h / 2, Math.max(0.1, w * 0.1 + Math.sin(time / 300) * 15), 0, Math.PI * 2)
      ctx.stroke()

      // Crosshairs
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)'
      ctx.lineWidth = 1
      ctx.beginPath()
      ctx.moveTo(0, h / 2)
      ctx.lineTo(w, h / 2)
      ctx.moveTo(w / 2, 0)
      ctx.lineTo(w / 2, h)
      ctx.stroke()

      // Label
      ctx.fillStyle = '#ffffff'
      ctx.textAlign = 'center'
      ctx.font = 'bold 36px "Outfit", sans-serif'
      ctx.fillText(label.toUpperCase(), w / 2, h / 2)
    }

    const renderSource = (ctx: CanvasRenderingContext2D, src: SceneSource, time: number) => {
      if (!src.visible) return

      ctx.save()
      ctx.globalAlpha = src.opacity
      
      if (src.settings?.blendMode) {
        ctx.globalCompositeOperation = src.settings.blendMode as any
      }

      // Transforms
      const cx = src.x + src.width / 2
      const cy = src.y + src.height / 2
      const rot = src.settings?.rotation || 0
      const scaleX = (src.settings?.scaleX ?? 1) * (src.settings?.flipHorizontal ? -1 : 1)
      const scaleY = (src.settings?.scaleY ?? 1) * (src.settings?.flipVertical ? -1 : 1)

      if (rot !== 0 || scaleX !== 1 || scaleY !== 1) {
        ctx.translate(cx, cy)
        ctx.rotate(rot * Math.PI / 180)
        ctx.scale(scaleX, scaleY)
        ctx.translate(-cx, -cy)
      }

      // Apply Filters
      let filterStr = ''
      src.filters?.filter(f => f.enabled).forEach(f => {
        updateDestination,
        startStreaming,
        stopStreaming,
        startRecording,
        stopRecording,
        startSingleStream,
        stopSingleStream,
        startAllStreams,
        stopAllStreams,
        toggleVirtualCamera,
        setChannelVolume,
        toggleChannelMute,
        updateChannelGain,
        updateChannelBalance,
        audioMeterLevels,
        cpuUsage,
        gpuUsage,
        ramUsage,
        gpuMemory,
        diskUsage,
        bitrate,
        droppedFrames,
        networkSpeed,
        
        // Phase 4 Additions
        workspacePreset,
        setWorkspacePreset,
        shortcuts,
        updateShortcut,
        logs,
        logEvent,
        toasts,
        addToast,
        removeToast,
        docks,
        setDocks,
        transitionType,
        setTransitionType,
        transitionDuration,
        setTransitionDuration,
        isTransitioning,
        transitionProgress,
        setTransitionProgress,
        prepareManualTransition,
        completeManualTransition,
        cancelManualTransition,
        previewCanvasRef,
        programCanvasRef,
        videoElements,
        imageElements,
        outputSettings,
        updateOutputSettings,
        autoTake,
        setAutoTake,
        virtualCameraSettings,
        updateVirtualCameraSettings,
        activeOverlays,
        toggleOverlay,
        duplicateSceneSetting,
        setDuplicateSceneSetting,
        duplicateSourcesSetting,
        setDuplicateSourcesSetting,
        swapScenesAfterTransition,
        setSwapScenesAfterTransition,
        programFilters,
        addProgramFilter,
        deleteProgramFilter,
        updateProgramFilterSettings,
        programResolution,
        setProgramResolution,
        ndiEnabled,
        setNdiEnabled,
        ndiName,
        setNdiName,
        renderTime,
        scanDirectoryRecursive,
        selectedSourceIds,
        setSelectedSourceIds,
        toggleSourceSelection,
        
        undo,
        redo,
        pushToUndoStack,
        saveStateForUndo,
        
        clipboardSource,
        setClipboardSource,
        clipboardSourceTransform,
        setClipboardSourceTransform,
        clipboardFilters,
        setClipboardFilters,
        mediaPlaylist
      }}
    >
      {children}
    </BroadcastContext.Provider>
  )
}

export const useBroadcast = () => {
  const context = useContext(BroadcastContext)
        }
      } else if (src.type === 'image') {
        const imageSrc = src.settings?.blobUrl || src.settings?.filePath
        if (imageSrc) {
          let resolvedPath = imageSrc
          if (/^[a-zA-Z]:/.test(imageSrc) || imageSrc.startsWith('/') || imageSrc.includes('\\') || imageSrc.startsWith('file:')) {
            const cleanPath = imageSrc.replace(/^file:\/+/i, '').replace(/\\/g, '/')
            resolvedPath = 'file:///' + cleanPath
          }
          const img = getOrCreateImage(src.id, resolvedPath)
          if (img.complete && img.naturalWidth > 0) {
            ctx.drawImage(img, src.x, src.y, src.width, src.height)
          }
        }
      } else if (src.type === 'slides') {
        const slideUrls = src.settings?.slideUrls || []
        const slideIndex = src.settings?.slideIndex || 0
        const currentSlideUrl = slideUrls[slideIndex]
        if (currentSlideUrl) {
          const img = getOrCreateImage(src.id, currentSlideUrl)
          if (img.complete && img.naturalWidth > 0) {
            ctx.drawImage(img, src.x, src.y, src.width, src.height)
          }
        } else {
          ctx.fillStyle = '#0f172a'
          ctx.fillRect(src.x, src.y, src.width, src.height)
          ctx.fillStyle = '#38bdf8'
          ctx.font = 'bold 36px "Outfit", sans-serif'
          ctx.textAlign = 'center'
          ctx.fillText(`Presentation Slide ${slideIndex + 1}`, src.x + src.width / 2, src.y + src.height / 2 - 20)
          ctx.fillStyle = '#94a3b8'
          ctx.font = '18px "Inter", sans-serif'
          ctx.fillText('No slide images uploaded in properties settings', src.x + src.width / 2, src.y + src.height / 2 + 30)
        }
      } else if (src.type === 'color_source') {
        ctx.fillStyle = src.settings?.backgroundColor || '#000000'
        ctx.fillRect(src.x, src.y, src.width, src.height)
      } else if (src.type === 'text') {
        ctx.fillStyle = src.settings?.textColor || '#ffffff'
        ctx.font = `bold ${src.settings?.textSize || 48}px "Inter", sans-serif`
        ctx.textAlign = 'left'
        ctx.textBaseline = 'top'
        ctx.fillText(src.settings?.textContent || '', src.x, src.y)
      } else if (src.type === 'lyrics') {
        ctx.fillStyle = 'rgba(0, 0, 0, 0.6)'
        ctx.fillRect(src.x, src.y + src.height - 180, src.width, 140)
        ctx.fillStyle = '#ffffff'
        ctx.font = 'bold 36px "Outfit", sans-serif'
        ctx.textAlign = 'center'
        ctx.fillText(src.settings?.textContent || 'LYRICS ACTIVE', src.x + src.width / 2, src.y + src.height - 130)
      } else if (src.type === 'browser' || src.type === 'html_overlay') {
        const url = src.settings?.url || 'https://google.com'
        const screenshotUrl = `https://api.microlink.io?url=${encodeURIComponent(url)}&screenshot=true&embed=screenshot.url`
        const img = getOrCreateImage(src.id, screenshotUrl)
        if (img.complete && img.naturalWidth > 0) {
          ctx.drawImage(img, src.x, src.y, src.width, src.height)
        } else {
          ctx.fillStyle = '#1e293b'
          ctx.fillRect(src.x, src.y, src.width, src.height)
          ctx.fillStyle = '#38bdf8'
          ctx.font = '18px monospace'
          ctx.fillText(`${src.type === 'html_overlay' ? 'HTML Overlay' : 'Browser Source'}: Loading ${url}...`, src.x + 20, src.y + 40)
        }
      } else if (src.type === 'clock') {
        const timeStr = new Date().toLocaleTimeString()
        ctx.fillStyle = src.settings?.textColor || '#ffffff'
        ctx.font = `bold ${src.settings?.textSize || 64}px "Outfit", sans-serif`
        ctx.textAlign = 'center'
        ctx.fillText(timeStr, src.x + src.width / 2, src.y + src.height / 2 + (src.settings?.textSize || 64)/3)
      } else if (src.type === 'countdown_timer') {
        ctx.fillStyle = src.settings?.textColor || '#ffffff'
        ctx.font = `bold ${src.settings?.textSize || 64}px "Outfit", sans-serif`
        ctx.textAlign = 'center'
        ctx.fillText('00:15:00', src.x + src.width / 2, src.y + src.height / 2 + (src.settings?.textSize || 64)/3)
      } else if (src.type === 'pdf') {
        ctx.fillStyle = '#ffffff'
        ctx.fillRect(src.x, src.y, src.width, src.height)
        ctx.fillStyle = '#ef4444'
        ctx.font = 'bold 32px "Outfit", sans-serif'
        ctx.textAlign = 'center'
        ctx.fillText('PDF VIEWER', src.x + src.width / 2, src.y + src.height / 2)
      } else if (src.type === 'slideshow') {
        ctx.fillStyle = '#0f172a'
        ctx.fillRect(src.x, src.y, src.width, src.height)
        ctx.fillStyle = '#10b981'
        ctx.font = 'bold 32px "Outfit", sans-serif'
        ctx.textAlign = 'center'
        ctx.fillText('SLIDESHOW: Image 1 of 5', src.x + src.width / 2, src.y + src.height / 2)
      } else if (src.type === 'vlc_source') {
        drawPattern(ctx, src.width, src.height, time, 'VLC Player')
      } else if (src.type === 'custom') {
        drawPattern(ctx, src.width, src.height, time, 'Test Pattern')
      }

      ctx.restore()
    }

    const renderScene = (ctx: CanvasRenderingContext2D, scene: Scene, time: number, targetName: string) => {
      if (!renderStateCache[targetName]) {
        renderStateCache[targetName] = { lastSources: {}, fullRedraw: true }
      }
      const cache = renderStateCache[targetName]

      // Determine dirty rectangle
      let dirtyRect: any = null
      let numDirty = 0
      
      const newSourceStates: Record<string, any> = {}

      for (let i = 0; i < scene?.sources?.length; i++) {
        const src = scene.sources[i]
        if (!src.visible) continue
        
        // Videos and active browsers are always dirty if they are playing
        let alwaysDirty = false
        const isVideoType = ['camera', 'media', 'video', 'display_capture', 'window_capture', 'game_capture', 'ndi', 'audio', 'browser'].includes(src.type)
        if (isVideoType) {
          const video = getOrCreateVideo(src.id, src)
          if (video && !video.paused) {
            alwaysDirty = true
          }
          if (src.type === 'browser') alwaysDirty = true // Web feeds can change arbitrarily
        }

        const stateHash = JSON.stringify({ x: src.x, y: src.y, w: src.width, h: src.height, op: src.opacity, s: src.settings, f: src.filters })
        newSourceStates[src.id] = stateHash

        const bb = getSourceBoundingBox(src)
        
        if (cache.lastSources[src.id] !== stateHash || alwaysDirty) {
          dirtyRect = unionRects(dirtyRect, bb)
          numDirty++
        }
      }

      // Check for deleted/hidden sources that need their old region cleared
      for (const id in cache.lastSources) {
        if (!newSourceStates[id]) {
          // Source was removed or hidden, we must mark its LAST bounding box as dirty.
          // Since we don't store the old bounding box, we do a full redraw for safety
          cache.fullRedraw = true
        }
      }

      cache.lastSources = newSourceStates

      // If full screen is dirty or too many things changed, just full redraw
      if (cache.fullRedraw || (dirtyRect && (dirtyRect.right - dirtyRect.left) * (dirtyRect.bottom - dirtyRect.top) > CANVAS_WIDTH * CANVAS_HEIGHT * 0.8)) {
        ctx.fillStyle = '#000000'
        ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT)
        for (let i = scene?.sources?.length - 1; i >= 0; i--) {
          renderSource(ctx, scene?.sources[i], time)
        }
        cache.fullRedraw = false
        return
      }

      // If no dirty rects at all, skip drawing completely! (0% GPU usage on static scenes)
      if (!dirtyRect) return

      // Clip and Redraw Dirty Region
      ctx.save()
      ctx.beginPath()
      ctx.rect(dirtyRect.left, dirtyRect.top, dirtyRect.right - dirtyRect.left, dirtyRect.bottom - dirtyRect.top)
      ctx.clip()
      
      // Clear dirty area with black background
      ctx.fillStyle = '#000000'
      ctx.fillRect(dirtyRect.left, dirtyRect.top, dirtyRect.right - dirtyRect.left, dirtyRect.bottom - dirtyRect.top)

      // Only draw sources that intersect the dirty rectangle
      for (let i = scene?.sources?.length - 1; i >= 0; i--) {
        const src = scene.sources[i]
        if (!src.visible) continue
        const bb = getSourceBoundingBox(src)
        if (rectIntersect(dirtyRect, bb)) {
          renderSource(ctx, src, time)
        }
      }

      ctx.restore()
    }

    const runCompositor = (time: number) => {
      const renderStart = performance.now()
      const pCanvas = programCanvasRef.current
      const pCtx = pCanvas?.getContext('2d')
      const prCanvas = previewCanvasRef.current
      const prCtx = prCanvas?.getContext('2d')

      // Get scenes
      const activeSc = (scenes || []).find(s => s.id === activeScene)
      let liveSc = (scenes || []).find(s => s.id === liveScene)
      if (!liveSc && liveScene && typeof liveScene === 'string' && liveScene.endsWith('_live')) {
        liveSc = (scenes || []).find(s => s.id === liveScene.replace('_live', ''))
      }

      // 1. Draw active scene to Preview monitor
      if (prCtx && activeSc) {
        renderScene(prCtx, activeSc, time, 'preview')
      }

      // 2. Draw live scene to Program monitor (supporting transitions)
      if (pCtx && liveSc) {
        pCtx.save()

        // Apply program-level color corrections and blur filters
        let pgmFilterStr = ''
        programFilters.forEach(f => {
          if (f.enabled) {
            if (f.type === 'color_correction') {
              const s = f.settings
              pgmFilterStr += `brightness(${s.brightness ?? 1.0}) contrast(${s.contrast ?? 1.0}) saturate(${s.saturation ?? 1.0}) hue-rotate(${s.hueRotate ?? 0}deg) `
            } else if (f.type === 'blur') {
              pgmFilterStr += `blur(${f.settings?.blur ?? 0}px) `
            }
          }
        })
        if (pgmFilterStr.trim()) {
          pCtx.filter = pgmFilterStr.trim()
        }

        if (isTransitioning && transitionFromScene) {
          // Find the "from" scene?. If the _live clone was replaced, fall back to the base scene?.
          let fromSc = (scenes || []).find(s => s.id === transitionFromScene)
          if (!fromSc && transitionFromScene && typeof transitionFromScene === 'string' && transitionFromScene.endsWith('_live')) {
            fromSc = (scenes || []).find(s => s.id === transitionFromScene.replace('_live', ''))
          }
          if (fromSc) {
            // Draw previous scene into a temporary transition buffer
            if (!transitionCanvasRef.current) {
              transitionCanvasRef.current = document.createElement('canvas')
            }
            const bufferCanvas = transitionCanvasRef.current
            bufferCanvas.width = CANVAS_WIDTH
            bufferCanvas.height = CANVAS_HEIGHT
            const bCtx = bufferCanvas.getContext('2d')!
            
            renderScene(bCtx, fromSc, time, 'transitionBuffer')

            pCtx.clearRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT)

            if (transitionType === 'fade') {
              pCtx.save()
              pCtx.globalAlpha = 1.0 - transitionProgress
              pCtx.drawImage(bufferCanvas, 0, 0)
              pCtx.restore()

              pCtx.save()
              pCtx.globalAlpha = transitionProgress
              renderScene(pCtx, liveSc, time, 'transitionBufferLive')
              pCtx.restore()
            } else if (transitionType === 'zoom') {
              pCtx.save()
              pCtx.globalAlpha = 1.0 - transitionProgress
              pCtx.translate(CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2)
              pCtx.scale(1.0 + transitionProgress * 0.5, 1.0 + transitionProgress * 0.5)
              pCtx.translate(-CANVAS_WIDTH / 2, -CANVAS_HEIGHT / 2)
              pCtx.drawImage(bufferCanvas, 0, 0)
              pCtx.restore()

              pCtx.save()
              pCtx.globalAlpha = transitionProgress
              pCtx.translate(CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2)
              pCtx.scale(0.5 + transitionProgress * 0.5, 0.5 + transitionProgress * 0.5)
              pCtx.translate(-CANVAS_WIDTH / 2, -CANVAS_HEIGHT / 2)
              renderScene(pCtx, liveSc, time, 'transitionBufferLive')
              pCtx.restore()
            } else if (transitionType === 'merge') {
              pCtx.save()
              pCtx.globalAlpha = 1.0 - transitionProgress
              pCtx.drawImage(bufferCanvas, 0, 0)
              pCtx.restore()

              pCtx.save()
              pCtx.globalAlpha = transitionProgress
              pCtx.translate(0, CANVAS_HEIGHT * 0.1 * (1.0 - transitionProgress))
              renderScene(pCtx, liveSc, time, 'transitionBufferLive')
              pCtx.restore()
            } else if (transitionType === 'slide') {
              pCtx.drawImage(bufferCanvas, 0, 0)
              pCtx.save()
              pCtx.translate(CANVAS_WIDTH * (1.0 - transitionProgress), 0)
              renderScene(pCtx, liveSc, time, 'transitionBufferLive')
              pCtx.restore()
            } else if (transitionType === 'push') {
              pCtx.save()
              pCtx.translate(-CANVAS_WIDTH * transitionProgress, 0)
              pCtx.drawImage(bufferCanvas, 0, 0)
              pCtx.restore()

              pCtx.save()
              pCtx.translate(CANVAS_WIDTH * (1.0 - transitionProgress), 0)
              renderScene(pCtx, liveSc, time, 'transitionBufferLive')
              pCtx.restore()
            } else if (transitionType === 'cube') {
              // Simulated 2D Cube Spin
              const offset = CANVAS_WIDTH * transitionProgress;
              
              pCtx.save();
              pCtx.globalAlpha = Math.max(0, 1.0 - transitionProgress * 1.5);
              pCtx.translate(-offset * 0.5, 0);
              pCtx.scale(1.0 - transitionProgress * 0.2, 1.0 - transitionProgress * 0.2);
              pCtx.drawImage(bufferCanvas, 0, 0);
              pCtx.restore();

              pCtx.save();
              pCtx.globalAlpha = Math.min(1.0, transitionProgress * 1.5);
              pCtx.translate(CANVAS_WIDTH - offset, 0);
              pCtx.scale(0.8 + transitionProgress * 0.2, 0.8 + transitionProgress * 0.2);
              renderScene(pCtx, liveSc, time, 'transitionBufferLive');
              pCtx.restore();
            } else if (transitionType === 'stinger') {
              pCtx.drawImage(bufferCanvas, 0, 0)
              renderScene(pCtx, liveSc, time, 'transitionBufferLive')
              
              // Fake stinger alpha mask
              pCtx.save()
              pCtx.globalCompositeOperation = 'destination-in'
              pCtx.fillStyle = `rgba(0,0,0,${transitionProgress > 0.5 ? 1.0 : 0.0})`
              pCtx.fillRect(0,0,CANVAS_WIDTH,CANVAS_HEIGHT)
              pCtx.restore()

              // Draw Stinger graphic over top
              pCtx.save()
              pCtx.fillStyle = 'rgba(56, 189, 248, 1.0)'
              pCtx.translate(CANVAS_WIDTH * 2 * transitionProgress - CANVAS_WIDTH, 0)
              pCtx.beginPath()
              pCtx.moveTo(0, 0)
              pCtx.lineTo(CANVAS_WIDTH, 0)
              pCtx.lineTo(CANVAS_WIDTH - 200, CANVAS_HEIGHT)
              pCtx.lineTo(-200, CANVAS_HEIGHT)
              pCtx.fill()
              pCtx.restore()
            } else if (transitionType === 'wipe') {
              pCtx.drawImage(bufferCanvas, 0, 0)
              pCtx.save()
              pCtx.beginPath()
              pCtx.rect(0, 0, CANVAS_WIDTH * transitionProgress, CANVAS_HEIGHT)
              pCtx.clip()
              renderScene(pCtx, liveSc, time, 'transitionBufferLive')
              pCtx.restore()
            } else if (transitionType === 'luma') {
              // Simulated Luma Wipe (using opacity block)
              pCtx.drawImage(bufferCanvas, 0, 0)
              pCtx.save()
              pCtx.globalCompositeOperation = 'destination-in'
              pCtx.fillStyle = `rgba(0,0,0,${transitionProgress})`
              pCtx.fillRect(0,0,CANVAS_WIDTH,CANVAS_HEIGHT)
              pCtx.restore()
              pCtx.save()
              pCtx.globalCompositeOperation = 'source-over'
              pCtx.globalAlpha = transitionProgress
              renderScene(pCtx, liveSc, time, 'transitionBufferLive')
              pCtx.restore()
            } else {
              renderScene(pCtx, liveSc, time, 'transitionBufferLive')
            }
          } else {
            renderScene(pCtx, liveSc, time)
          }
        } else {
          renderScene(pCtx, liveSc, time)
        }

        pCtx.restore()

        // Render active overlays (1 to 4) on top of PGM output
        const overlaySlots = [1, 2, 3, 4]
        overlaySlots.forEach(slot => {
          const overlaySceneId = activeOverlays[slot]
          if (overlaySceneId) {
            const overlaySc = (scenes || []).find(s => s.id === overlaySceneId)
            if (overlaySc) {
              pCtx.save()
              
              if (slot === 1) {
                // Fullscreen overlay
              } else if (slot === 2) {
                // Bottom-right PiP (1/4 size)
                pCtx.translate(1400, 770)
                pCtx.scale(0.25, 0.25)
              } else if (slot === 3) {
                // Lower-third overlay (width: 1920, height: 360 at bottom)
                pCtx.translate(0, 720)
                pCtx.scale(1.0, 0.333)
              } else if (slot === 4) {
                // Top-left PiP (1/4 size)
                pCtx.translate(40, 40)
                pCtx.scale(0.25, 0.25)
              }

              renderScene(pCtx, overlaySc, time)
              pCtx.restore()
            }
          }
        })
      }

      // 3. Draw custom scene to dedicated vcam canvas if virtual camera is routing custom scene
      if (virtualCameraSettings.source === 'custom' && virtualCameraSettings.customSceneId) {
        const customSc = (scenes || []).find(s => s.id === virtualCameraSettings.customSceneId)
        if (!vcamCanvasRef.current) {
          vcamCanvasRef.current = document.createElement('canvas')
        }
        const oCanvas = vcamCanvasRef.current
        const oCtx = oCanvas?.getContext('2d')
        if (oCanvas && oCtx && customSc) {
          const [wStr, hStr] = (virtualCameraSettings.resolution || '1920x1080').split('x')
          oCanvas.width = parseInt(wStr) || 1920
          oCanvas.height = parseInt(hStr) || 1080
          renderScene(oCtx, customSc, time)
        }
      }

      // Update VU meters from active audio channels
      const levels: Record<string, { vu: number; peak: number }> = {}
      scenes.forEach(sc => {
        sc.sources?.forEach(src => {
          const audioNodes = sourceAudioNodesRef.current[src.id]
          if (audioNodes && !src.muted) {
            // Read frequency or amplitude levels from AnalyserNode
            const bufferLength = audioNodes.analyserNode.frequencyBinCount
            const dataArray = new Uint8Array(bufferLength)
            audioNodes.analyserNode.getByteTimeDomainData(dataArray)

            let sum = 0
            for (let i = 0; i < bufferLength; i++) {
              const val = (dataArray[i] - 128) / 128
              sum += val * val
            }
            const rms = Math.sqrt(sum / bufferLength)
            const vu = Math.min(100, Math.floor(rms * 250 * (src.volume / 100)))
            
            levels[src.id] = {
              vu,
              peak: vu // Simplified peak hold
            }
          } else {
            levels[src.id] = { vu: 0, peak: 0 }
          }
        })
      })
      
      if (time - lastAudioUpdate > 100) {
        lastAudioUpdate = time
        setAudioMeterLevels(prev => {
          if (JSON.stringify(prev) === JSON.stringify(levels)) return prev;
          return levels;
        })
      }

      const renderEnd = performance.now()
      const renderDiff = renderEnd - renderStart
      if (Math.random() < 0.1) {
        setRenderTime(parseFloat(renderDiff.toFixed(1)))
      }

      animId = requestAnimationFrame(runCompositor)
    }

    animId = requestAnimationFrame(runCompositor)
    return () => {
      cancelAnimationFrame(animId)
    }
  }, [scenes, activeScene, liveScene, isTransitioning, transitionProgress, transitionType, virtualCameraSettings, activeOverlays, programFilters])

  return (
    <BroadcastContext.Provider
      value={{
        desktopSources,
        loadDesktopSources,
        activeScene,
        liveScene,
        scenes,
        setScenes,
        pinnedScenes,
        selectScene,
        takeLive,
        cutTransition,
        autoTransition,
        addScene,
        deleteScene,
        duplicateScene,
        togglePinScene,
        updateSceneOrder,
        addSourceToScene,
        deleteSourceFromScene,
        updateSourceProperties,
        addFilterToSource,
        deleteFilterFromSource,
        duplicateFilterFromSource,
        reorderFilter: (sceneId: SceneId, sourceId: string, filterId: string, direction: 'up'|'down') => {
          saveStateForUndo()
          setScenes(prev => prev.map(s => {
            if (s.id !== sceneId) return s
            return {
              ...s,
              sources: s.sources.map(src => {
                if (src.id !== sourceId) return src
  )
}

export const useBroadcast = () => {
  const context = useContext(BroadcastContext)
  
  const safeContext = context || ({} as BroadcastContextType)

  return new Proxy(safeContext, {
    get: (target, prop) => {
      if (prop in target && target[prop as keyof typeof target] !== undefined) {
        return target[prop as keyof typeof target]
      }
      // Defensive fallbacks for any missing state
      if (typeof prop === 'string') {
        if (['scenes', 'docks', 'desktopSources', 'pinnedScenes', 'destinations', 'programFilters', 'smartTools'].includes(prop)) return []
        if (prop.startsWith('set') || prop.startsWith('update') || prop.startsWith('toggle') || prop.startsWith('add') || prop.startsWith('delete')) {
          return () => {}
        }
        if (['isStreaming', 'isRecording', 'virtualCameraActive', 'isTransitioning', 'duplicateSceneSetting', 'duplicateSourcesSetting', 'swapScenesAfterTransition', 'ndiEnabled'].includes(prop)) return false
        if (['streamingDuration', 'recordingDuration', 'cpuUsage', 'gpuUsage', 'bitrate', 'droppedFrames', 'networkSpeed', 'transitionDuration', 'transitionProgress', 'renderTime'].includes(prop)) return 0
        if (['ndiName'].includes(prop)) return null
        if (['selectedSourceIds', 'clipboardFilters'].includes(prop)) return []
        if (['clipboardSource'].includes(prop)) return null
        if (['activeScene', 'liveScene'].includes(prop)) return ''
        if (prop.endsWith('Elements') || prop.endsWith('Levels') || prop.endsWith('Overlays') || prop.endsWith('Settings')) return {}
      }
      return undefined
    }
  }) as BroadcastContextType
}

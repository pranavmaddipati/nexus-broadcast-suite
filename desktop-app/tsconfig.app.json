{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": [
    "src/context/BroadcastContext.tsx",
    "src/store/broadcastStore.ts",
    "src/store/slices/**",
    "src/components/SceneMatrix.tsx",
    "src/components/VmixInputCard.tsx",
    "src/components/SceneRenderer.tsx",
    "src/components/SourceConfigurationPopup.tsx",
    "src/components/SourceProperties/**",
    "src/components/SourceSettingsModal.tsx",
    "src/components/VirtualCameraSettingsModal.tsx",
    "src/components/InputSelectionDialog.tsx",
    "src/components/MacrosPanel.tsx",
    "src/components/PropertiesPanel.tsx",
    "src/components/SystemStatusPanel.tsx",
    "src/components/TransitionEngine.tsx",
    "src/engine/media/MediaPlayer.ts"
  ]
}
